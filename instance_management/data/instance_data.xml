<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- System Parameter for odoo version's deamon configuration -->
        <record id="v18_deamon_id" model="ir.config_parameter">
            <field name="key">18.0</field>
            <field name="value">/home/serpentcs/workspace/18.0/odoo-bin</field>
            <field name="for_version">1</field>
        </record>
        <record id="v19_deamon_id" model="ir.config_parameter">
            <field name="key">19.0</field>
            <field name="value">/home/serpentcs/workspace/odoo_ce/19.0CE/odoo-bin</field>
            <field name="for_version">1</field>
        </record>
        
        <!-- System Parameter for instance config and log file directory -->
        <record id="instance_config" model="ir.config_parameter">
            <field name="key">instance_config_path</field>
            <field name="value">/home/serpentcs/odoo_instance_config/</field>
        </record>
        <record id="instance_log" model="ir.config_parameter">
            <field name="key">instance_logfile_path</field>
            <field name="value">/home/serpentcs/odoo_instance_log/</field>
        </record>
        
        <!-- System Parameter for instance Root User -->
        <record id="instance_user" model="ir.config_parameter">
            <field name="key">instance_user</field>
            <field name="value">serpentcs</field>
        </record>
        
        <!-- demo data for repository -->
        <record id="git_repo" model="repo.repo">
            <field name="name">GIT</field>
            <field name="code">git</field>
        </record>
        
    </data>
</odoo>
