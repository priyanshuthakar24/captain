<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dashboard Client Action -->
    <record id="action_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">instance_management.dashboard</field>
    </record>

    <!-- Dashboard Menu -->
    <menuitem
        id="menu_dashboard"
        name="Dashboard"
        parent="menu_main_instance"
        action="action_dashboard"
        sequence="1"
        groups="instance_management.instance_user_group,instance_management.instance_manager_group"/>

</odoo>