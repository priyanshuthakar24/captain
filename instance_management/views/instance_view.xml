<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Instance list view -->
        <record id="view_tree_instance" model="ir.ui.view">
            <field name="name">view.list.instance</field>
            <field name="model">instance.instance</field>
            <field name="arch" type="xml">
                <list string="Instance">
                    <field name="name"/>
                    <field name="odoo_version"/>
                    <field name="http_port"/>
                    <field name="db_name"/>
                    <field name="pid"/>
                    <field name="requested_by"/>
                    <field name="gevent_port"/>
                    <field name="status" string="Instance Status"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

 <record id="view_search_instance" model="ir.ui.view">
            <field name="name">view.search.instance</field>
            <field name="model">instance.instance</field>
            <field name="arch" type="xml">
                <search string="Search Instance">
                    <field name="name"/>
                    <field name="odoo_version"/>
                    <field name="http_port"/>
                    <field name="gevent_port"/>
                    <field name="db_name"/>
                    <field name="state"/>
                    <group>
                        <filter name="group_state"
                                string="State"
                                context="{'group_by': 'state'}"/>
                                <filter
                            name="group_by_version"
                            string="Version"
                            context="{'group_by': 'odoo_version'}"/>
                    </group>
                        <filter
                name="running"
                string="Running"
                domain="[('pid', '!=', False)]"/>

            <filter
                name="stopped"
                string="Stopped"
                domain="[('pid', '=', False)]"/>
                        </search>
                    </field>
                </record>
        <!-- Instance form view -->
        <record id="view_form_instance_id" model="ir.ui.view">
            <field name="name">view.form.instance</field>
            <field name="model">instance.instance</field>
            <field name="arch" type="xml">
                <form string="Instance">
                    <header>
                        <!-- <button name="%(action_import_instance_wizard)d" type="action" string="Import Existing" class="btn-secondary" icon="fa-download" groups="instance_management.instance_manager_group"/> -->
                        <button name="validate" string="Validate" type="object" class="oe_highlight"
                                invisible="state != 'draft' or status != 'Stopped'"
                                groups="instance_management.instance_manager_group"/>
                        <button name="start_server" string="Start" type="object" class="oe_highlight"
                                invisible="state != 'confirm' or status != 'Stopped'" help="Click to start the instance"/>
                        <button name="stop_server" string="Stop" type="object" class="oe_highlight"
                                invisible="status == 'Stopped'" help="Click to stop the instance"/>
                        <button name="restart_server" string="Restart" type="object" class="oe_highlight"
                                invisible="state != 'confirm'" help="Click to restart the instance"/>

                        <button name="restart_postgres" string="Restart Postgres" invisible="state not in ('confirm','running','stop')" type="object" groups="instance_management.instance_manager_group"/>
                        <!-- <button name="check_instance_status" string="Check Status" type="object" invisible="state not in ('confirm','running','stop')" help="Click to Check the status of the instance"/> -->
                        <button name="download_logfile" string="Download Log File" type="object"
                                invisible="state != 'confirm'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group col="4">
                            <field name="name" required="1"/>
                            <field name="odoo_version" required="1" domain="[('for_version','=',True)]" widget="selection"/>
                            <field name="http_port"/>
                            <field name="db_name"/>
                            <field name="gevent_port"/>
                            <field name="requested_by"/>
                            <field name="status"/>
                        </group>
                        <notebook>
                            <page name="server_config" string="Server File Configuration" groups="instance_management.instance_manager_group">
                                <group name="server_config" groups="instance_management.instance_manager_group">
                                    <field name="server_config" placeholder="Define config paramater like..[Options]admin_user,db_host,db_port,addons_path etc" nolabel="1"/>
                                </group>
                            </page>
                            <page string="Branch" name="branch_path">
                                <field name="branch_ids">
                                    <list string="Branch" editable="top">
                                        <field name="branch_path"/>
                                        <field name="repo_id"/>
                                        <button name="get_revisions" string="Latest Pull" type="object" help="Click to take latest reveisions on the defined branch path"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Action of Instance -->
        <record id="action_instance" model="ir.actions.act_window">
            <field name="name">Instance</field>
            <field name="res_model">instance.instance</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'is_restrict_instence_based_on_users': True}</field>
        </record>
<!-- Bulk Start -->
<record id="action_bulk_start_instances" model="ir.actions.server">
    <field name="name">Start Selected Instances</field>
    <field name="model_id" ref="model_instance_instance"/>
    <field name="binding_model_id" ref="model_instance_instance"/>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">
action = records.action_bulk_start()
action = {
    "type": "ir.actions.client",
    "tag": "reload",
}

    </field>
</record>

<record id="action_bulk_stop_instances" model="ir.actions.server">
    <field name="name">Stop Selected Instances</field>
    <field name="model_id" ref="model_instance_instance"/>
    <field name="binding_model_id" ref="model_instance_instance"/>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">
action = records.action_bulk_stop()
action = {
    "type": "ir.actions.client",
    "tag": "reload",
}

    </field>
</record>

<record id="action_bulk_restart_instances" model="ir.actions.server">
    <field name="name">Restart Selected Instances</field>
    <field name="model_id" ref="model_instance_instance"/>
    <field name="binding_model_id" ref="model_instance_instance"/>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">
action = records.action_bulk_restart()
action = {
    "type": "ir.actions.client",
    "tag": "reload",
}

    </field>
</record>
        <!-- Menu for the Instance module -->
<menuitem
    id="menu_main_instance"
    name="Captain"
    web_icon="instance_management,static/description/icon.png"
    groups="instance_management.instance_user_group,instance_management.instance_manager_group"/>

<menuitem
    id="menu_instance"
    name="Instance Management"
    parent="menu_main_instance"
    groups="instance_management.instance_user_group,instance_management.instance_manager_group"/>

<menuitem
    id="menu_instance_child"
    name="Instances"
    parent="menu_instance"
    action="action_instance"
    groups="instance_management.instance_user_group,instance_management.instance_manager_group"/>
        <!-- List view of Repo -->
        <record id="view_tree_repo_id" model="ir.ui.view">
            <field name="name">view.list.repo</field>
            <field name="model">repo.repo</field>
            <field name="arch" type="xml">
                <list string="Repository">
                    <field name="name"/>
                    <field name="code"/>
                </list>
            </field>
        </record>

        <!-- Action of Repo -->
        <record id="action_repo" model="ir.actions.act_window">
            <field name="name">Repository</field>
            <field name="res_model">repo.repo</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="menu_repo_repo" name="Repository" parent="menu_instance" action="action_repo" groups="instance_management.instance_manager_group"/>
        <menuitem id="menu_import_instance" name="Import Existing" parent="menu_instance" action="action_import_instance_wizard" groups="instance_management.instance_manager_group"/>
    </data>
</odoo>