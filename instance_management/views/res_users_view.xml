<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_users_form_instance" model="ir.ui.view">
            <field name="name">res.users.form.instance</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook/page[@name='access_rights']" position="after">
                    <page string="GIT configurations" groups="instance_management.instance_manager_group">
                        <group>
                            <group>
                                <field name="git_id"/>
                                <field name="git_pass" password="True"/>
                            </group>
                            <group>
                                <field name="instance_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
