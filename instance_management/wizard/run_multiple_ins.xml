<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_run_multiple_ins" model="ir.ui.view">
            <field name="name">Operate Multiple Instance</field>
            <field name="model">run.multiple.ins</field>
            <field name="arch" type="xml">
                <form string="Instance">
                    <separator string="Operate Multiple Instances"/>
                    <button string="Start" name="start" type="object" class="oe_highlight"/>
                    <button string="Stop" name="stop" type="object" class="oe_highlight"/>
                    <button string="Restart" name="restart" type="object" class="oe_highlight"/>
                    <button special="cancel" string="Cancel" class="oe_highlight"/>
                </form>
            </field>
        </record>
        
        <record id="action_run_multi_ins" model="ir.actions.act_window">
            <field name="name">Start/Stop/Restart</field>
            <field name="res_model">run.multiple.ins</field>
            <field name="binding_model_id" ref="instance_management.model_instance_instance"/>
            <field name="binding_view_types">list</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="groups_id" eval="[(4, ref('instance_management.instance_manager_group'))]"/>
        </record>
    </data>
</odoo>
