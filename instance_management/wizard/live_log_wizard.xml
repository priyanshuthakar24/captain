<odoo>

    <record id="view_live_log_wizard" model="ir.ui.view">
        <field name="name">instance.live.log.wizard.form</field>
        <field name="model">instance.live.log.wizard</field>

        <field name="arch" type="xml">
            <form string="Live Logs">

                <group>

                    <field name="instance_id"/>

                    <field
                        name="log_text"
                        nolabel="1"
                        readonly="1"
                        widget="text"
                        style="height:600px;font-family:monospace;"
                    />

                </group>

                <footer>

                    <button
                        string="Close"
                        special="cancel"
                        class="btn-secondary"/>

                </footer>

            </form>
        </field>
    </record>

</odoo>