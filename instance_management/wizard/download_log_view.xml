<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_download_log_file" model="ir.ui.view">
            <field name="name">download.log.wizard</field>
            <field name="model">download.log</field>
            <field name="arch" type="xml">
                <form>
                    <field name="name" invisible="1"/>
                    <h4>Click on Link To Download Log File:&#160;<field name="file_download" filename="name" nolabel="1"/></h4>
                    <separator string="" colspan="4"/>
                    <footer>
                        <button special="cancel" string="Cancel" colspan="2"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
