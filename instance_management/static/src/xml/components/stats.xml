<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="instance_management.Stats">

    <div class="captain-stats">

        <StatCard
        title="'Instances'"
        value="props.state.total_instances"
        subtitle="'All managed instances'"
        icon="'fa-server'"
        color="'primary'"
        />

        <StatCard
            title="'Running'"
            value="props.state.running_instances"
            subtitle="'Currently running'"
            icon="'fa-play-circle'"
            color="'success'"
        />

        <StatCard
            title="'Stopped'"
            value="props.state.stopped_instances"
            subtitle="'Currently stopped'"
            icon="'fa-stop-circle'"
            color="'danger'"
        />

        <StatCard
            title="'Databases'"
            value="props.state.databases"
            subtitle="'Available databases'"
            icon="'fa-database'"
            color="'warning'"
        />

    </div>

</t>

</templates>